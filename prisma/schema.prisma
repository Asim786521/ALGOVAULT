// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// prisma/schema.prisma
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress  Progress[]    
  achievements Achievement[]  
  leaderboard Leaderboard[] 
}

enum Role {
  USER
  ADMIN
}
model Problem {
  id          String   @id @default(uuid())
  title       String
  topic       String
  difficulty  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress    Progress[]
}

enum ProgressStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Progress {
  id        String           @id @default(uuid())
  solved    Boolean          @default(false)
  solvedAt  DateTime?
  userId    String
  problemId String
  status    ProgressStatus?  // Using enum for status

  user      User             @relation(fields: [userId], references: [id])
  problem   Problem          @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId]) // Ensure a user can only have one progress entry per problem
}


model Achievement {
  id        String   @id @default(uuid())
  name      String
  achievedAt DateTime @default(now())
  userId    String

  user      User     @relation(fields: [userId], references: [id])
}

model Leaderboard {
  id        String   @id @default(uuid())
  userId    String
  rank      Int
  points    Int
  updatedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}